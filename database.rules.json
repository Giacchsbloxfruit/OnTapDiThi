{
  "rules": {
    ".read": false,
    ".write": false,
    "questionsPublic": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "exams": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "examKeys": {
      ".read": false,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        "history": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid"
        },
        "profile": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "questionKeys": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "vips": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "leaderboard": {
      ".read": true,
      ".write": false
    },
    "battles": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() && newData.child('hostUid').val() === auth.uid || data.child('hostUid').val() === auth.uid)",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('battles').child($code).exists()"
          }
        }
      }
    }
  }
}
